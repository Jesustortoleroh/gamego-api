{
  "name": "gamego-api",
  "version": "1.0.0",
  "description": "REST API for GameGo online store",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test --experimental-test-coverage --test-reporter=spec",
